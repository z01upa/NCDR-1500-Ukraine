{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "request_id",
    "origin_task",
    "missing_capability",
    "reproducer",
    "expected_behavior",
    "acceptance_tests",
    "bounded_worktree",
    "priority"
  ],
  "properties": {
    "request_id": {
      "type": "string"
    },
    "origin_task": {
      "type": "string"
    },
    "missing_capability": {
      "type": "string"
    },
    "reproducer": {
      "type": "string"
    },
    "expected_behavior": {
      "type": "string"
    },
    "acceptance_tests": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "bounded_worktree": {
      "type": "string"
    },
    "priority": {
      "type": "integer",
      "minimum": 0,
      "maximum": 5
    },
    "error_signature": {
      "type": "string"
    },
    "input_hashes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "max_attempts": {
      "type": "integer",
      "minimum": 1,
      "maximum": 3
    }
  }
}
